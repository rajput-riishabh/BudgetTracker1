@model BudgetTrackerWebApp.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1>Dashboard</h1>

<div id="dashboard-data">
    @if (Model != null)
    {
        <h3>@Model.WelcomeMessage</h3>
        <p>Total Expenses This Month: ₹@Model.TotalExpensesThisMonth</p>
        <p>Budget Remaining: ₹@Model.BudgetRemaining</p>
        // ... Display other properties from Model ...
    }
    else
    {
        <p>Error loading dashboard data.</p> @* Or display ViewBag.ErrorMessage if you prefer *@
        @if (ViewBag.ErrorMessage != null)
        {
            <p class="error">@ViewBag.ErrorMessage</p>
        }
    }
</div>
