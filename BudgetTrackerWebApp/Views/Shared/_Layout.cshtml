<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BudgetBuddy</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    @* <p style="color: red; font-size: larger; font-weight: bold;">LAYOUT CHECK TEXT - IS THIS VISIBLE?</p> *@
    <header>
        <nav id="navbar-top" class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto">
                        @* Left side navbar items *@
                        @if (User.Identity?.IsAuthenticated != true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-area="" asp-controller="Auth" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-area="" asp-controller="Auth" asp-action="Register">
                                    <i class="bi bi-person-plus-fill"></i> Register
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Profile">
                                    <i class="bi bi-person-circle"></i> Welcome, @User.Identity.Name
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Expenses">
                                    <i class="bi bi-currency-dollar"></i> Expenses
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Budgets">
                                    <i class="bi bi-wallet-fill"></i> Budgets
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Income">
                                    <i class="bi bi-cash-coin"></i> Income
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Reports">
                                    <i class="bi bi-file-earmark-bar-graph-fill"></i> Reports
                                </a>
                            </li>
                            <li class="nav-item">
                                <form class="form-inline" asp-area="" asp-controller="Auth" asp-action="Logout" method="post">
                                    <button type="submit" class="nav-link btn btn-link text-light"><i class="bi bi-box-arrow-right"></i> Logout</button>
                                </form>
                            </li>
                        }
                    </ul>
                    <a class="link-secondary" href="#" aria-label="Add a new report">

                        <a class="nav-link text-light website-name" asp-area="" asp-controller="Home" asp-action="Dashboard"><i class="bi bi-bank"><span>BudgetBuddy</span></i></a> @* Website name with icon in sidebar *@
                    </a> @* Website name on right in Navbar *@
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid main-content-wrapper">
        <div class="row">
            <nav id="sidebar" class="col-md-3 col-lg-2 d-md-block  sidebar">
                <div class="position-sticky pt-3">
                    <h5 class="sidebar-heading d-flex justify-content-center align-items-left py-1 mt-0 mb-1 text-muted">
                        <a class="link-secondary" href="#" aria-label="Add a new report">
                            
                            <a class="nav-link text-light website-name" asp-area="" asp-controller="Home" asp-action="Dashboard"><i class="bi bi-bank"><span>BudgetBuddy</span></i></a> @* Website name with icon in sidebar *@
                        </a>
                    </h5>

                    <ul class="nav flex-column sidebar-nav">
                        @if (User.Identity?.IsAuthenticated != true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-area="" asp-controller="Auth" asp-action="Register">
                                    <i class="bi bi-person-plus-fill"></i> Register
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-area="" asp-controller="Auth" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Login
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Profile">
                                    <i class="bi bi-person-circle"></i>  Welcome, @User.Identity.Name
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Dashboard">
                                    <i class="bi bi-house-door"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Expenses">
                                    <i class="bi bi-currency-rupee"></i> Expenses
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Budgets">
                                    <i class="bi bi-wallet-fill"></i> Budgets
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Income">
                                    <i class="bi bi-cash-stack"></i> Income
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Reports">
                                    <i class="bi bi-file-earmark-bar-graph-fill"></i> Reports
                                </a>
                            </li>
                            <li class="nav-item">
                                <form class="form-inline" asp-area="" asp-controller="Auth" asp-action="Logout" method="post">
                                    <button type="submit" class="nav-link btn btn-link text-light"> <i class="bi bi-box-arrow-left"></i> Logout</button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </nav>

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="footer border-top text-muted footer-container">
        <div class="container">
            &copy; 2025 - BudgetBuddy - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>