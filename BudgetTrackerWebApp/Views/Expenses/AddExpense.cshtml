@{
    ViewData["Title"] = "Add New Expense";
}

<div class="container">
    <h1 id="pageTitle">Add New Expense</h1>

    <form id="addExpenseForm" method="post" asp-controller="Expenses" asp-action="Create">
        <input type="hidden" id="ExpenseId" name="ExpenseId" value="" /> @* Hidden input to store ExpenseId in edit mode *@ 
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label for="Date" class="form-label">Date</label>
            <input type="date" class="form-control" id="Date" name="Date" required />
            <span id="date-error" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label for="CategoryId" class="form-label">Category</label>
            <select class="form-select" id="CategoryId" name="CategoryId" required>
                <option value="">-- Select Category --</option>
                @* Categories will be loaded here dynamically *@
            </select>
            <span id="category-error" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label for="Description" class="form-label">Description</label>
            <textarea class="form-control" id="Description" name="Description" rows="3" required></textarea>
            <span id="description-error" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label for="Amount" class="form-label">Amount</label>
            <input type="number" class="form-control" id="Amount" name="Amount" step="1" required />
            <span id="amount-error" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary" id="submitButton">Add Expense</button>
        <a asp-action="Expenses" asp-controller="Home" class="btn btn-secondary ms-2">Cancel</a>
        <div id="form-error" class="alert alert-danger mt-3" style="display:none;"></div> 
        <div id="form-success" class="alert alert-success mt-3" style="display:none;"></div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>

         function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
            return null; // Cookie not found
        }



        document.addEventListener('DOMContentLoaded', function () {
            fetchCategories().then(() => {
                console.log("fetchCategories completed. Calling checkAndLoadExpenseForEdit...");
                checkAndLoadExpenseForEdit();
            }).catch(error => {
                console.error("fetchCategories failed:", error);
            });

            const formElement = document.getElementById('addExpenseForm');
            formElement.addEventListener('submit', handleFormSubmit);
        });


       

        async function fetchCategories() {
            return new Promise(async (resolve, reject) => {
                const categoryDropdown = document.getElementById('CategoryId');
                console.log("fetchCategories: categoryDropdown element:", categoryDropdown);
                try {
                    const response = await fetch('http://localhost:5285/api/Categories', {
                        headers: {
                            'Authorization': 'Bearer ' + getCookie('authToken'),
                            'Content-Type': 'application/json'
                        }
                    });

                    if (!response.ok) {
                        console.error('Failed to load categories:', response.status, response.statusText);
                        categoryDropdown.innerHTML = '<option value="">-- Error loading categories --</option>';
                        reject('Failed to load categories');
                        return;
                    }

                    const categories = await response.json();
                    console.log("fetchCategories: Categories fetched from API:", categories);
                    populateCategoryDropdown(categories);
                    resolve();
                } catch (error) {
                    console.error('Error fetching categories:', error);
                    categoryDropdown.innerHTML = '<option value="">-- Error loading categories --</option>';
                    reject('Error fetching categories');
                }
            });
        }






        function populateCategoryDropdown(categories) {
            const categoryDropdown = document.getElementById('CategoryId');
            console.log("populateCategoryDropdown: categoryDropdown element:", categoryDropdown);
            console.log("populateCategoryDropdown: Categories received:", categories);
            // Keep the default option in HTML, don't reset innerHTML here.

            // Clear any existing options *except* the first one (default "-- Select Category --")
            while (categoryDropdown.options.length > 1) {
                categoryDropdown.remove(1); // Remove options starting from index 1
            }

            categories.forEach(category => {
                const option = document.createElement('option');
                option.value = category.categoryId;
                option.textContent = category.name;
                categoryDropdown.appendChild(option);
                console.log("populateCategoryDropdown: Added option:", option, "for category:", category);
            });
            console.log("populateCategoryDropdown: Dropdown options after population:", categoryDropdown.options);
        }





        function checkAndLoadExpenseForEdit() {
            console.log("checkAndLoadExpenseForEdit: Started");
            const urlParams = new URLSearchParams(window.location.search);
            const expenseId = urlParams.get('expenseId');

            if (expenseId) {
                console.log("checkAndLoadExpenseForEdit: Expense ID found in URL:", expenseId);
                loadExpenseForEdit(expenseId);
                document.getElementById('pageTitle').textContent = 'Edit Expense';
                document.getElementById('submitButton').textContent = 'Save Changes';
            } else {
                console.log("checkAndLoadExpenseForEdit: No Expense ID in URL - Add New Mode.");
            }
            console.log("checkAndLoadExpenseForEdit: Finished");
        }






        async function loadExpenseForEdit(expenseId) {
            try {
                const response = await fetch(`http://localhost:5285/api/Expenses/${expenseId}`, { // API endpoint to get expense by ID
                    headers: {
                        'Authorization': 'Bearer ' + getCookie('authToken'),
                        'Content-Type': 'application/json'
                    }
                });

                if (!response.ok) {
                    console.error('Failed to load expense for edit:', response.status, response.statusText);
                    displayGeneralError('Failed to load expense for editing.'); // Display error to user
                    return;
                }

                const expense = await response.json();
                populateFormForEdit(expense); // Populate form with expense data

            } catch (error) {
                console.error('Error fetching expense for edit:', error);
                displayGeneralError('Error fetching expense details.'); // Display error to user
            }
        }




        function populateFormForEdit(expense) {
            document.getElementById('ExpenseId').value = expense.expenseId; // Set hidden ExpenseId input
            const utcDate = new Date(expense.date + 'Z'); // Append 'Z' to indicate UTC
            document.getElementById('Date').value = utcDate.toISOString().slice(0, 10); // Format date for input[type=date]

            console.log("populateFormForEdit: Setting CategoryId dropdown value to:", expense.categoryId, "(Type:", typeof expense.categoryId, ")");
            document.getElementById('CategoryId').value = expense.categoryId; // Set Category dropdown value

            document.getElementById('Description').value = expense.description;
            document.getElementById('Amount').value = expense.amount;
        }




        async function handleFormSubmit(event) {
            event.preventDefault(); // Prevent default form submission
            const form = document.getElementById('addExpenseForm');
            // Clear any previous error messages
            document.getElementById('form-error').style.display = 'none';
            document.getElementById('form-success').style.display = 'none';
            clearValidationErrors(); // Clear individual field error messages

            const expenseId = document.getElementById('ExpenseId').value; // Get ExpenseId from hidden input

            const formData = {
                expenseId: expenseId ? parseInt(expenseId) : 0, // Include expenseId if in edit mode
                date: document.getElementById('Date').value,
                categoryId: parseInt(document.getElementById('CategoryId').value), // Parse to integer
                description: document.getElementById('Description').value,
                amount: parseFloat(document.getElementById('Amount').value)         // Parse to float
            };

            const isEditMode = expenseId !== ""; // Determine if it's edit mode based on ExpenseId

            try {
                const apiUrl = isEditMode ? `http://localhost:5285/api/Expenses/${expenseId}` : 'http://localhost:5285/api/Expenses'; // Determine API URL based on mode
                const method = isEditMode ? 'PUT' : 'POST'; // Determine HTTP method based on mode

                const response = await fetch(apiUrl, { // Your API endpoint to create expense
                    method: method,
                    headers: {
                        'Authorization': 'Bearer ' + getCookie('authToken'),
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(formData) // Convert data to JSON
                });

                if (response.ok) {
                    // Success message based on mode
                    const successMessage = isEditMode ? 'Expense updated successfully!' : 'Expense added successfully!';
                    document.getElementById('form-success').textContent = successMessage;
                    document.getElementById('form-success').style.display = 'block';
                    form.reset(); // Clear the form
                    // Optionally, redirect to Expenses page after a short delay:
                    setTimeout(() => {
                        window.location.href = '@Url.Action("Expenses", "Home")'; // Redirect to Expenses page
                    }, 1500); // Wait 1.5 seconds before redirecting
                } else {
                    // ... (Error handling - unchanged, but consider adapting messages for edit vs. add if needed) ...
                    console.error('Error ' + (isEditMode ? 'updating' : 'adding') + ' expense:', response.status, response.statusText);
                    if (response.status === 400) {
                        try {
                            const errorData = await response.json();
                            displayValidationErrors(errorData);
                        } catch (parseError) {
                            displayGeneralError('Failed to ' + (isEditMode ? 'update' : 'add') + ' expense. Please check your input and try again.');
                        }
                    } else if (response.status === 401 || response.status === 403) {
                        displayGeneralError('Authentication failed. Please log in again.');
                    }
                    else {
                        displayGeneralError(`Failed to ${isEditMode ? 'update' : 'add'} expense. Server error: ${response.status} - ${response.statusText}`);
                    }
                }


            } catch (error) {
                console.error('Fetch error:', error);
                displayGeneralError('Failed to ' + (isEditMode ? 'update' : 'add') + ' expense. Network error. Please try again later.');
            }
        }




        function displayValidationErrors(errorData) {
            // ... (Your displayValidationErrors function - unchanged) ...
            console.log("Validation Errors from API:", errorData); // Log for debugging

            if (errorData.errors) { // Check if it's in the ModelState format
                for (const fieldName in errorData.errors) {
                    const errorMessages = errorData.errors[fieldName];
                    const errorSpanId = fieldName.toLowerCase() + '-error'; // e.g., "date-error"
                    const errorSpan = document.getElementById(errorSpanId);
                    if (errorSpan) {
                        errorSpan.textContent = errorMessages.join(' '); // Display all error messages for the field
                    } else {
                        console.warn(`Error span not found for field: ${fieldName} (ID: ${errorSpanId})`); // Warn if span not found
                    }
                }
            } else if (typeof errorData === 'string') { // Check if API returned a simple string error message
                displayGeneralError(errorData);
            } else {
                displayGeneralError('Validation errors occurred, but could not display details. Check console.'); // Generic validation error if format unexpected
            }
        }

        function clearValidationErrors() {
            // ... (Your clearValidationErrors function - unchanged) ...
            document.querySelectorAll('.text-danger').forEach(span => {
                span.textContent = '';
            });
        }



        function displayGeneralError(message) {
            // ... (Your displayGeneralError function - unchanged) ...
            const errorDiv = document.getElementById('form-error');
            errorDiv.textContent = message;
            errorDiv.style.display = 'block';
        }


    </script>
}